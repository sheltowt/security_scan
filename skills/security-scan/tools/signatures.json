{
  "$comment": "Phase 0 prefilter signatures. A match is a triage signal that prioritizes coverage units and seeds hunter context. It is never a finding. Patterns are JavaScript regular expressions applied to one line at a time; keep them linear (no nested quantifiers) so hostile input cannot cause catastrophic backtracking.",
  "version": 1,
  "language_groups": {
    "js": [
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".vue",
      ".svelte"
    ],
    "py": [
      ".py",
      ".pyw"
    ],
    "go": [
      ".go"
    ],
    "jvm": [
      ".java",
      ".kt",
      ".kts",
      ".scala",
      ".groovy"
    ],
    "rb": [
      ".rb",
      ".erb",
      ".rake"
    ],
    "php": [
      ".php",
      ".phtml"
    ],
    "cs": [
      ".cs",
      ".cshtml"
    ],
    "native": [
      ".c",
      ".h",
      ".cc",
      ".cpp",
      ".cxx",
      ".hpp",
      ".hh",
      ".hxx",
      ".m",
      ".mm"
    ],
    "rs": [
      ".rs"
    ],
    "sol": [
      ".sol"
    ],
    "move": [
      ".move"
    ],
    "sh": [
      ".sh",
      ".bash",
      ".zsh"
    ],
    "yaml": [
      ".yml",
      ".yaml"
    ],
    "tf": [
      ".tf",
      ".tfvars",
      ".hcl"
    ],
    "docker": [
      "Dockerfile",
      "Containerfile",
      ".dockerfile"
    ],
    "web": [
      ".html",
      ".htm",
      ".js",
      ".jsx",
      ".ts",
      ".tsx",
      ".vue",
      ".svelte"
    ],
    "config": [
      ".json",
      ".yml",
      ".yaml",
      ".toml",
      ".ini",
      ".env",
      ".properties",
      ".conf",
      ".cfg",
      ".xml"
    ],
    "any": [
      "*"
    ]
  },
  "rules": [
    {
      "id": "secret.private-key",
      "title": "Private key material",
      "languages": [
        "any"
      ],
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "high"
    },
    {
      "id": "secret.aws-access-key",
      "title": "AWS access key ID",
      "languages": [
        "any"
      ],
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "high"
    },
    {
      "id": "secret.github-token",
      "title": "GitHub token",
      "languages": [
        "any"
      ],
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{60,255})\\b",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "high"
    },
    {
      "id": "secret.slack-token",
      "title": "Slack token",
      "languages": [
        "any"
      ],
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,200}\\b",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "high"
    },
    {
      "id": "secret.stripe-live-key",
      "title": "Stripe live secret key",
      "languages": [
        "any"
      ],
      "pattern": "\\b[sr]k_live_[A-Za-z0-9]{20,200}\\b",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "high"
    },
    {
      "id": "secret.llm-api-key",
      "title": "LLM provider API key",
      "languages": [
        "any"
      ],
      "pattern": "\\b(?:sk-ant-[A-Za-z0-9_-]{20,300}|sk-proj-[A-Za-z0-9_-]{20,300}|AIza[0-9A-Za-z_-]{35})\\b",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "high"
    },
    {
      "id": "secret.generic-assignment",
      "title": "Credential-like literal assignment",
      "languages": [
        "any"
      ],
      "pattern": "(?:password|passwd|secret|api_?key|access_?token|auth_?token|client_?secret)[\"']?\\s{0,4}[:=]\\s{0,4}[\"'][^\"'\\s$<{]{8,200}[\"']",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-798"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "marker.security-todo",
      "title": "Security-related TODO/FIXME",
      "languages": [
        "any"
      ],
      "pattern": "\\b(?:TODO|FIXME|HACK|XXX)\\b[^\\n]{0,80}\\b(?:auth|permission|csrf|xss|sanitiz|validat|escape|secur|inject|tenant|owner)",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [],
      "severity_hint": "low"
    },
    {
      "id": "marker.disabled-check",
      "title": "Disabled or bypassed security check",
      "languages": [
        "any"
      ],
      "pattern": "\\b(?:skip|bypass|disable|no)_?(?:auth|authz|csrf|verify|verification|ssl|tls|signature)\\b",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Access control",
      "cwe": [
        "CWE-285"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.eval",
      "title": "Dynamic code evaluation",
      "languages": [
        "js"
      ],
      "pattern": "(?:^|[^.\\w])(?:eval|Function)\\s{0,4}\\(|new\\s+Function\\s{0,4}\\(|vm\\.(?:runIn\\w+Context|Script|compileFunction)\\b",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-95"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.child-process",
      "title": "Shell or process execution",
      "languages": [
        "js"
      ],
      "pattern": "\\b(?:exec|execSync|spawn|spawnSync|execFile|execFileSync|fork)\\s{0,4}\\(|\\bshell\\s{0,4}:\\s{0,4}true\\b",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-78"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.sql-concat",
      "title": "SQL built from string concatenation or interpolation",
      "languages": [
        "js"
      ],
      "pattern": "(?:\\.query|\\.execute|\\.raw|\\$queryRawUnsafe|\\$executeRawUnsafe|knex\\.raw|sequelize\\.query)\\s{0,4}\\(\\s{0,4}(?:`[^`]{0,400}\\$\\{|[\"'][^\"']{0,400}[\"']\\s{0,4}\\+)",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-89"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.nosql-operator",
      "title": "Query object taken directly from request",
      "languages": [
        "js"
      ],
      "pattern": "\\.(?:find|findOne|updateOne|updateMany|deleteMany|aggregate)\\s{0,4}\\(\\s{0,4}req\\.(?:body|query|params)\\b",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-943"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.dom-sink",
      "title": "Raw HTML DOM sink",
      "languages": [
        "web"
      ],
      "pattern": "\\.(?:innerHTML|outerHTML)\\s{0,4}=|insertAdjacentHTML\\s{0,4}\\(|document\\.write(?:ln)?\\s{0,4}\\(|dangerouslySetInnerHTML|v-html\\s{0,4}=|\\{@html\\s",
      "class": "CLIENT-SIDE.md#DOM-based XSS",
      "cwe": [
        "CWE-79"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.postmessage-listener",
      "title": "postMessage listener (check origin validation)",
      "languages": [
        "web"
      ],
      "pattern": "addEventListener\\s{0,4}\\(\\s{0,4}[\"']message[\"']|\\bonmessage\\s{0,4}=",
      "class": "CLIENT-SIDE.md#`postMessage` origin and source trust",
      "cwe": [
        "CWE-346"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.prototype-merge",
      "title": "Recursive merge or path set (prototype pollution)",
      "languages": [
        "js"
      ],
      "pattern": "\\b(?:merge|deepMerge|defaultsDeep|mergeWith|setWith|set)\\s{0,4}\\([^)]{0,200}req\\.(?:body|query)|\\[\\s{0,4}(?:key|k|prop|name)\\s{0,4}\\]\\s{0,4}=\\s{0,4}[^=]",
      "class": "CLIENT-SIDE.md#Prototype pollution and gadget chain",
      "cwe": [
        "CWE-1321"
      ],
      "severity_hint": "low"
    },
    {
      "id": "js.path-join-request",
      "title": "Filesystem path built from request input",
      "languages": [
        "js"
      ],
      "pattern": "(?:path\\.(?:join|resolve)|fs\\.\\w+|sendFile|createReadStream|readFile)\\s{0,4}\\([^)]{0,200}req\\.(?:params|query|body|path|url)\\b",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-22"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.ssrf-fetch",
      "title": "Outbound request to request-controlled URL",
      "languages": [
        "js"
      ],
      "pattern": "(?:fetch|axios(?:\\.\\w+)?|got|request|http\\.get|https\\.get|undici\\.request)\\s{0,4}\\([^)]{0,120}(?:req\\.(?:body|query|params)|url|uri|href|target|callback|webhook)",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-918"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.open-redirect",
      "title": "Redirect to request-controlled location",
      "languages": [
        "js"
      ],
      "pattern": "\\.redirect\\s{0,4}\\([^)]{0,80}req\\.(?:query|body|params)|location(?:\\.href)?\\s{0,4}=\\s{0,4}[^;]{0,80}(?:searchParams|query|params|next|returnTo|redirect)",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-601"
      ],
      "severity_hint": "low"
    },
    {
      "id": "js.jwt-weak-verify",
      "title": "JWT decoded without verification or with permissive algorithms",
      "languages": [
        "js"
      ],
      "pattern": "jwt\\.decode\\s{0,4}\\(|algorithms\\s{0,4}:\\s{0,4}\\[[^\\]]{0,40}[\"']none[\"']|ignoreExpiration\\s{0,4}:\\s{0,4}true",
      "class": "WEB-PROTOCOL-AND-AUTH.md#JWT verification and claim binding",
      "cwe": [
        "CWE-347"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.cors-reflect",
      "title": "Permissive or reflected CORS with credentials",
      "languages": [
        "js"
      ],
      "pattern": "origin\\s{0,4}:\\s{0,4}(?:true|[\"']\\*[\"'])|Access-Control-Allow-Origin[\"']?\\s{0,4}[,:]\\s{0,4}(?:req\\.headers|origin|[\"']\\*)",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-942"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.insecure-random",
      "title": "Math.random for a security-sensitive value",
      "languages": [
        "js"
      ],
      "pattern": "(?:token|secret|nonce|salt|password|otp|session|key)\\w{0,20}\\s{0,4}=\\s{0,4}[^;]{0,80}Math\\.random\\s{0,4}\\(",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Cryptography and secrets",
      "cwe": [
        "CWE-338"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "js.tls-disabled",
      "title": "TLS verification disabled",
      "languages": [
        "js"
      ],
      "pattern": "rejectUnauthorized\\s{0,4}:\\s{0,4}false|NODE_TLS_REJECT_UNAUTHORIZED[\"']?\\s{0,4}[=:]\\s{0,4}[\"']?0",
      "class": "CRYPTOGRAPHY.md#Transport and certificate validation",
      "cwe": [
        "CWE-295"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.unsafe-deserialize",
      "title": "Unsafe deserialization",
      "languages": [
        "js"
      ],
      "pattern": "\\b(?:node-serialize|serialize-javascript|funcster)\\b|\\bunserialize\\s{0,4}\\(|yaml\\.load\\s{0,4}\\([^)]{0,80}(?:unsafe|JSON_SCHEMA\\s{0,4}:\\s{0,4}false)",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-502"
      ],
      "severity_hint": "high"
    },
    {
      "id": "js.llm-tool-exec",
      "title": "Model output reaches a tool, shell, or code sink",
      "languages": [
        "js",
        "py"
      ],
      "pattern": "(?:tool_calls?|function_call|toolUse|tool_use)[^\\n]{0,120}(?:exec|eval|spawn|subprocess|os\\.system|child_process|fetch|query)",
      "class": "AI-AND-LLM.md#Tool-argument injection into a downstream sink",
      "cwe": [
        "CWE-77"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "llm.prompt-assembly",
      "title": "Untrusted content concatenated into a prompt",
      "languages": [
        "js",
        "py"
      ],
      "pattern": "(?:system_?prompt|systemPrompt|messages|prompt)\\s{0,4}(?:\\+?=|:)\\s{0,4}[^\\n]{0,80}(?:req\\.|request\\.|user_input|document|html|email|page_content|retriev)",
      "flags": "i",
      "class": "AI-AND-LLM.md#Indirect injection through retrieved or ingested content",
      "cwe": [
        "CWE-1427"
      ],
      "severity_hint": "low"
    },
    {
      "id": "py.eval",
      "title": "Dynamic code evaluation",
      "languages": [
        "py"
      ],
      "pattern": "(?:^|[^.\\w])(?:eval|exec|compile)\\s{0,4}\\(",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-95"
      ],
      "severity_hint": "high"
    },
    {
      "id": "py.shell",
      "title": "Shell execution",
      "languages": [
        "py"
      ],
      "pattern": "os\\.(?:system|popen|exec\\w{0,3})\\s{0,4}\\(|subprocess\\.\\w+\\([^)]{0,300}shell\\s{0,4}=\\s{0,4}True|commands\\.getoutput",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-78"
      ],
      "severity_hint": "high"
    },
    {
      "id": "py.sql-format",
      "title": "SQL built with string formatting",
      "languages": [
        "py"
      ],
      "pattern": "\\.(?:execute|executemany|raw|extra)\\s{0,4}\\(\\s{0,4}(?:f[\"']|[\"'][^\"']{0,300}[\"']\\s{0,4}(?:%|\\.format\\s{0,4}\\(|\\+))",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-89"
      ],
      "severity_hint": "high"
    },
    {
      "id": "py.unsafe-deserialize",
      "title": "Unsafe deserialization",
      "languages": [
        "py"
      ],
      "pattern": "\\b(?:pickle|cPickle|dill|shelve|marshal)\\.loads?\\s{0,4}\\(|yaml\\.(?:load|unsafe_load)\\s{0,4}\\((?![^)]{0,120}SafeLoader)|torch\\.load\\s{0,4}\\((?![^)]{0,120}weights_only\\s{0,4}=\\s{0,4}True)|jsonpickle\\.decode",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-502"
      ],
      "severity_hint": "high"
    },
    {
      "id": "py.template-injection",
      "title": "Template rendered from a dynamic string",
      "languages": [
        "py"
      ],
      "pattern": "render_template_string\\s{0,4}\\(|Template\\s{0,4}\\([^)]{0,80}(?:request|input|user)|Environment\\s{0,4}\\([^)]{0,200}autoescape\\s{0,4}=\\s{0,4}False|\\|\\s{0,4}safe\\b|mark_safe\\s{0,4}\\(",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-1336"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "py.path-request",
      "title": "Filesystem path from request input",
      "languages": [
        "py"
      ],
      "pattern": "(?:open|send_file|send_from_directory|FileResponse|os\\.path\\.join)\\s{0,4}\\([^)]{0,200}request\\.(?:args|form|values|GET|POST|files|json|query_params|path_params)",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-22"
      ],
      "severity_hint": "high"
    },
    {
      "id": "py.archive-extract",
      "title": "Archive extraction without member validation",
      "languages": [
        "py"
      ],
      "pattern": "\\.extractall\\s{0,4}\\((?![^)]{0,120}filter\\s{0,4}=)|shutil\\.unpack_archive\\s{0,4}\\(",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-22"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "py.ssrf",
      "title": "Outbound request to request-controlled URL",
      "languages": [
        "py"
      ],
      "pattern": "(?:requests|httpx|urllib\\.request|aiohttp\\.ClientSession\\(\\))\\.(?:get|post|put|request|urlopen)\\s{0,4}\\([^)]{0,120}(?:request\\.|url|uri|callback|webhook|target)",
      "flags": "i",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-918"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "py.tls-disabled",
      "title": "TLS verification disabled",
      "languages": [
        "py"
      ],
      "pattern": "verify\\s{0,4}=\\s{0,4}False|ssl\\._create_unverified_context|CERT_NONE|check_hostname\\s{0,4}=\\s{0,4}False",
      "class": "CRYPTOGRAPHY.md#Transport and certificate validation",
      "cwe": [
        "CWE-295"
      ],
      "severity_hint": "high"
    },
    {
      "id": "py.weak-random",
      "title": "random module for a security-sensitive value",
      "languages": [
        "py"
      ],
      "pattern": "(?:token|secret|nonce|salt|password|otp|session|key)\\w{0,20}\\s{0,4}=\\s{0,4}[^\\n]{0,80}\\brandom\\.(?:random|randint|choice|choices|getrandbits|randrange)\\s{0,4}\\(",
      "flags": "i",
      "class": "CRYPTOGRAPHY.md#Randomness and key generation",
      "cwe": [
        "CWE-338"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "py.debug-enabled",
      "title": "Debug mode enabled",
      "languages": [
        "py"
      ],
      "pattern": "\\bDEBUG\\s{0,4}=\\s{0,4}True\\b|\\.run\\s{0,4}\\([^)]{0,120}debug\\s{0,4}=\\s{0,4}True",
      "class": "ATTACK-CLASSES.md#Obvious things",
      "cwe": [
        "CWE-489"
      ],
      "severity_hint": "low"
    },
    {
      "id": "py.csrf-exempt",
      "title": "CSRF protection disabled",
      "languages": [
        "py"
      ],
      "pattern": "@csrf_exempt|WTF_CSRF_ENABLED\\s{0,4}=\\s{0,4}False|csrf\\s{0,4}=\\s{0,4}False",
      "class": "WEB-PROTOCOL-AND-AUTH.md#Ordinary CSRF",
      "cwe": [
        "CWE-352"
      ],
      "severity_hint": "medium"
    },
    {
      "id": "go.shell",
      "title": "Process execution",
      "languages": [
        "go"
      ],
      "pattern": "exec\\.Command(?:Context)?\\s{0,4}\\(\\s{0,4}(?:\"(?:sh|bash|cmd|powershell)\"|[a-z]\\w{0,40}\\s{0,4}[,)])",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-78"
      ],
      "severity_hint": "high"
    },
    {
      "id": "go.sql-format",
      "title": "SQL built with fmt.Sprintf or concatenation",
      "languages": [
        "go"
      ],
      "pattern": "\\.(?:Query|QueryRow|Exec|QueryContext|ExecContext|Raw)\\s{0,4}\\(\\s{0,4}(?:ctx\\s{0,4},\\s{0,4})?(?:fmt\\.Sprintf|\"[^\"]{0,300}\"\\s{0,4}\\+)",
      "class": "ATTACK-CLASSES.md#Injection",
      "cwe": [
        "CWE-89"
      ],
      "severity_hint": "high"
    },
    {
      "id": "go.path-join",
      "title": "filepath.Join with request input",
      "languages": [
        "go"
      ],
      "pattern": "(?:filepath|path)\\.Join\\s{0,4}\\([^)]{0,200}(?:r\\.URL|r\\.Form|Query\\(\\)|Param\\(|PathValue\\()|http\\.ServeFile\\s{0,4}\\(",
      "class": "ATTACK-CLASSES.md#Resource and file handling",
      "cwe": [
        "CWE-22"
      ],
      "severity_hint": "high"
    },
    {
      "id": "go.tls-skip-verify",
      "title": "TLS verification disabled",
      "languages": [
        "go"
      ],
      "pattern": "InsecureSkipVerify\\s{0,4}:\\s{0,4}true",
      "class": "CRYPTOGRAPHY.md#Transport and certificate validation",
      "cwe": [
        "CWE-295"
      ],
      "severity_hint": "high"
    },
    {
      "id": "go.math-rand",
      "title": "math/rand imported (check security-sensitive use)",
      "languages": [
        "go"
      ],
      "pattern": "\"math/rand(?:/v2)?\"",
      "class": "CRYPTOGRAPHY.md#Randomness and key generation",
      "cwe": [
        "CWE-338"
      ],
      "severity_hint": "low"
    },
    {
      "id": "go.unsafe",
      "title": "unsafe or cgo boundary",
      "languages": [
        "go"
      ],
      "pattern": "\\bunsafe\\.Pointer\\b|^import\\s+\"C\"",
